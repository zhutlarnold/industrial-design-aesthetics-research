  "claims": [
    {
      "id": "IDA-C-volvo-mechanism",
      "case_id": "volvo-thors-hammer-headlight",
      "type": "fact",
      "text": "EX90 团队访谈说明远近光模块放在横向日行灯后，机械开合为照明模块让出位置；不推广到全部地区配置。",
      "sources": [
        "IDA-S-volvo-interview",
        "H025"
      ],
      "premises": [],
      "publishable": true
    },
    {
      "id": "IDA-C-volvo-welcome",
      "case_id": "volvo-thors-hammer-headlight",
      "type": "artist_intent",
      "text": "团队希望灯的动作像醒来和睡去；官方将迎宾动作描述为欢迎回家。",
      "sources": [
        "IDA-S-volvo-interview",
        "H025"
      ],
      "premises": [],
      "publishable": true
    },
    {
      "id": "IDA-C-volvo-expression",
      "case_id": "volvo-thors-hammer-headlight",
      "type": "interpretation",
      "text": "光与机械运动借熟悉的眼睛动作，使车辆看起来有表情；亲近感不证明可靠性。",
      "sources": [],
      "premises": [
        "IDA-C-volvo-mechanism",
        "IDA-C-volvo-welcome"
      ],
      "publishable": true
    },
    {
      "id": "IDA-C-salif-design-date",
      "case_id": "philippe-starck-juicy-salif",
      "type": "fact",
      "text": "Starck 与 MoMA 将设计记为1988年；其他馆藏口径不同，不把设计年份等同所有藏品制作年。",
      "sources": [
        "IDA-S-salif-starck",
        "IDA-S-salif-moma"
      ],
      "premises": [],
      "publishable": true
    },
    {
      "id": "IDA-C-salif-path",
      "case_id": "philippe-starck-juicy-salif",
      "type": "fact",
      "text": "沟槽与三足结构使汁液直接进入下方杯子，没有配套筛网隔开籽和果肉。",
      "sources": [
        "IDA-S-salif-aberdeen"
      ],
      "premises": [],
      "publishable": true
    },
    {
      "id": "IDA-C-salif-conversation",
      "case_id": "philippe-starck-juicy-salif",
      "type": "artist_intent",
      "text": "Starck 在2021年回看作品时把它描述为能激发想象、引起交谈的小雕塑；不是1988年原始意图记录。",
      "sources": [
        "IDA-S-salif-reflection"
      ],
      "premises": [],
      "publishable": true
    },
    {
      "id": "IDA-C-salif-value",
      "case_id": "philippe-starck-juicy-salif",
      "type": "interpretation",
      "text": "雕塑般的轮廓可产生欣赏与交谈的价值，保留它的理由仍需与操作习惯相处。",
      "sources": [],
      "premises": [
        "IDA-C-salif-path",
        "IDA-C-salif-conversation"
      ],
      "publishable": true
    },
    {
      "id": "IDA02-C-china-awards",
      "case_id": "volvo-thors-hammer-headlight",
      "type": "fact",
      "text": "2023第四届车灯评选的两项年度颜值类别分别授予极星4前灯与智己LS7前灯；公众20%、注册评委50%、特邀评委30%，不代表普遍消费者审美排名。",
      "sources": [
        "IDA02-S-7ff71451edd5"
      ],
      "premises": [],
      "publishable": true
    },
    {
      "id": "IDA02-C-dvn-vote",
      "case_id": "volvo-thors-hammer-headlight",
      "type": "fact",
      "text": "DVN 2025前灯前三项为Grandland26%、Audi Avant e-tron23%、DS N°8 16%；公告整体796票122家公司，前灯分母未公开，设计技术未分开。",
      "sources": [
        "IDA02-S-14873702041c"
      ],
      "premises": [],
      "publishable": true
    },
    {
      "id": "IDA02-C-formal-concepts",
      "case_id": "volvo-thors-hammer-headlight",
      "type": "fact",
      "text": "Getty教育材料讨论线形明度空间、比例均衡节奏统一变化；本文术语简化依据该材料，不作为普遍喜好实验。",
      "sources": [
        "IDA02-S-e646daf07d69",
        "IDA02-S-4c86d7b5c121"
      ],
      "premises": [],
      "publishable": true
    },
    {
      "id": "IDA02-C-polestar-observed",
      "case_id": "polestar-4-headlight",
      "type": "fact",
      "text": "原图中上下灯带分开，两端的转折方向不同。",
      "sources": [
        "IDA02-S-7ff71451edd5"
      ],
      "premises": [],
      "publishable": true
    },
    {
      "id": "IDA02-C-polestar-formal-reading",
      "case_id": "polestar-4-headlight",
      "type": "interpretation",
      "text": "间隙和统一中的变化使灯组显得较薄、轻巧。",
      "sources": [],
      "premises": [
        "IDA02-C-polestar-observed",
        "IDA02-C-formal-concepts"
      ],
      "publishable": true
    },
    {
      "id": "IDA02-C-ls7-observed",
      "case_id": "im-ls7-headlight",
      "type": "fact",
      "text": "原图中灯带横向延伸后在外侧弯起，与周围车身面相接。",
      "sources": [
        "IDA02-S-7ff71451edd5"
      ],
      "premises": [],
      "publishable": true
    },
    {
      "id": "IDA02-C-ls7-formal-reading",
      "case_id": "im-ls7-headlight",
      "type": "interpretation",
      "text": "弧线方向与转折塑造流动感；曲线不必优于直线。",
      "sources": [],
      "premises": [
        "IDA02-C-ls7-observed",
        "IDA02-C-formal-concepts"
      ],
      "publishable": true
    },
    {
